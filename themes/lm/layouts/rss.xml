{{- /* Feed RSS (só as Notas geram feed; ver content/notas/_index.md). */ -}}
{{- $paginas := .RegularPages.ByDate.Reverse -}}
{{- $titulo := cond .IsHome site.Title (printf "%s · %s" .Title site.Title) -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $titulo }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{- with $paginas }}<lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $paginas }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- range .GetTerms "assuntos" }}
      <category>{{ .LinkTitle }}</category>
      {{- end }}
      <description>{{ .Description | default .Summary | plainify | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
