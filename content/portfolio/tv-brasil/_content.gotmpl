{{/* Gera uma página por produção da TV Brasil/EBC a partir de data/ebc.yaml */}}
{{ .EnableAllLanguages }}
{{ $lang := .Site.Language.Lang }}
{{ range partialCached "dados.html" (dict "nome" "ebc" "lang" $lang) "ebc" $lang }}
  {{ $c := dict "mediaType" "text/markdown" "value" (.sinopse | default "") }}
  {{ $.AddPage (dict "path" .id "title" .titulo "kind" "page" "content" $c "params" .) }}
{{ end }}
